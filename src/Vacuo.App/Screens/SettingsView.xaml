<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vacuo.App.Screens.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vacuo.App.Screens">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Click="OnBackClick" />
            <TextBlock x:Name="ScreenTitle"
                       AutomationProperties.HeadingLevel="Level1"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource InkBrush}" />
        </Grid>

        <ScrollViewer x:Name="SettingsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8" Padding="0,0,12,12">
                <!-- Language: Automatic follows Windows (Turkish, else English); a change shows at once. -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="LanguageTitle" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:Name="LanguageHint" Style="{StaticResource CardBodyStyle}" />
                        </StackPanel>
                        <local:VoidPicker x:Name="LanguagePicker" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Start with Windows: only Vacuo's own value in the user's Run key (vacuo-kurallar 5). The low-disk
                     notice shares the card: both need the tray, so without it the card is hidden. Its detail is in a
                     tooltip, so Settings still fits without a scroll bar (Alican). -->
                <Border x:Name="StartupCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="StartupTitle" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="StartupHint" Style="{StaticResource CardBodyStyle}" />
                                <TextBlock x:Name="StartupNote"
                                           Style="{StaticResource CardBodyStyle}"
                                           Foreground="{ThemeResource AccentBrush}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                            <CheckBox x:Name="StartupBox"
                                      Grid.Column="1"
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      Click="OnStartupClick" />
                        </Grid>
                        <CheckBox x:Name="LowDiskBox" Click="OnLowDiskClick" />
                    </StackPanel>
                </Border>

                <!-- Updates (vacuo-kurallar 6): reads GitHub's release list only; turned off, Vacuo never goes online. -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="UpdatesTitle" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="UpdatesHint" Style="{StaticResource CardBodyStyle}" />
                            </StackPanel>
                            <CheckBox x:Name="UpdatesBox"
                                      Grid.Column="1"
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      Click="OnUpdatesBoxClick" />
                        </Grid>
                        <!-- The state and its buttons share one line, so Settings fits without a scroll bar. -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="UpdatesState"
                                       Style="{StaticResource CardBodyStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource InkBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CheckNowButton" Click="OnCheckNowClick" />
                                <Button x:Name="UpdateNowButton"
                                        Style="{StaticResource VoidPrimaryButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="OnUpdateNowClick" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Otomatik Bakım (ADR-004): off until turned on (vacuo-kurallar 2); the choices show what it would do. -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="MaintenanceTitle" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="MaintenanceHint" Style="{StaticResource CardBodyStyle}" />
                                <TextBlock x:Name="MaintenanceLastRun" Style="{StaticResource CardBodyStyle}" Foreground="{ThemeResource InkBrush}" />
                            </StackPanel>
                            <CheckBox x:Name="MaintenanceBox"
                                      Grid.Column="1"
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      Click="OnMaintenanceClick" />
                        </Grid>
                        <!-- Two columns, short labels with the detail in a tooltip: Settings fits without a scroll bar (Alican). -->
                        <Grid ColumnSpacing="16" RowSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="TempFilesBox" Click="OnMaintenanceClick" />
                            <CheckBox x:Name="DownloadCachesBox" Grid.Column="1" Click="OnMaintenanceClick" />
                            <CheckBox x:Name="ProjectLeftoversBox" Grid.Row="1" Click="OnMaintenanceClick" />
                            <CheckBox x:Name="OrganizeDesktopBox" Grid.Row="1" Grid.Column="1" Click="OnMaintenanceClick" />
                            <CheckBox x:Name="SoundBox" Grid.Row="2" Click="OnMaintenanceClick" />
                            <TextBlock x:Name="MaintenanceModelsNote" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource CardBodyStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- About, privacy, licenses and terms: each row opens its text in the reading page below. -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="InfoTitle" Style="{StaticResource CardTitleStyle}" />
                        <!-- One row of four (Alican, 23 October 2026): the low-disk row took the height, so the page needs no scroll bar. -->
                        <Grid x:Name="InfoRows" ColumnSpacing="8" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- The text of one info page, in place of the settings until Back. -->
        <ScrollViewer x:Name="ReadingPage"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <StackPanel x:Name="ReadingText" Spacing="10" Padding="0,0,12,12" MaxWidth="720" HorizontalAlignment="Left" />
        </ScrollViewer>
    </Grid>
</UserControl>
