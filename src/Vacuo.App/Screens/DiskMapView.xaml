<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vacuo.App.Screens.DiskMapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- A box, a header and a pill are one flat shape; hover and press lighten it, whatever its colour. -->
        <Style x:Key="MapBoxStyle" TargetType="Button">
            <Setter Property="Padding" Value="7" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Shine.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Shine.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Shine" Background="{ThemeResource ShineBrush}" Opacity="0" />
                            <ContentPresenter Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Click="OnBackClick" />
            <TextBlock x:Name="ScreenTitle"
                       AutomationProperties.HeadingLevel="Level1"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource InkBrush}" />
            <TextBlock x:Name="UsedText"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="{ThemeResource InkSecondaryBrush}" />
            <Button x:Name="RescanButton" Grid.Column="3" Click="OnRescanClick" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled">
                <StackPanel x:Name="TrailPanel" Orientation="Horizontal" Spacing="2" />
            </ScrollViewer>
            <Button x:Name="MapPill" Grid.Column="1" Style="{StaticResource MapBoxStyle}" CornerRadius="14" Padding="12,5" BorderThickness="1" Click="OnMapPillClick" />
            <Button x:Name="ListPill" Grid.Column="2" Style="{StaticResource MapBoxStyle}" CornerRadius="14" Padding="12,5" BorderThickness="1" Click="OnListPillClick" />
        </Grid>

        <Grid x:Name="MapFrame"
              Grid.Row="2"
              CornerRadius="6"
              Background="{ThemeResource SurfaceBrush}"
              SizeChanged="OnMapFrameSizeChanged">
            <Canvas x:Name="MapCanvas" />
            <ScrollViewer x:Name="ListScroller" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel x:Name="ListPanel" Spacing="2" Padding="8,8,14,8" />
            </ScrollViewer>
            <StackPanel x:Name="ScanPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Visibility="Collapsed">
                <Ellipse Width="84" Height="84" AutomationProperties.AccessibilityView="Raw">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF0A0811" Offset="0.4" />
                            <GradientStop Color="#FF9D7CFF" Offset="0.46" />
                            <GradientStop Color="#409D7CFF" Offset="0.6" />
                            <GradientStop Color="#009D7CFF" Offset="0.72" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock x:Name="ScanPercent"
                           HorizontalAlignment="Center"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentBrush}" />
                <TextBlock x:Name="ScanNote"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Style="{StaticResource CardBodyStyle}" />
                <Button x:Name="StopButton" HorizontalAlignment="Center" Click="OnStopClick" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NoteText"
                       VerticalAlignment="Center"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{ThemeResource InkSecondaryBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock x:Name="RampLess" FontSize="12" Foreground="{ThemeResource InkSecondaryBrush}" />
                <Border Width="72" Height="8" VerticalAlignment="Center" CornerRadius="2" AutomationProperties.AccessibilityView="Raw">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#FF241C38" Offset="0" />
                            <GradientStop Color="#FF352A50" Offset="0.4" />
                            <GradientStop Color="#FF4E3E78" Offset="0.8" />
                            <GradientStop Color="#FF5C4A8E" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock x:Name="RampMore" FontSize="12" Foreground="{ThemeResource InkSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4"
              MinHeight="34"
              ColumnSpacing="8"
              BorderBrush="{ThemeResource LineBrush}"
              BorderThickness="0,1,0,0"
              Padding="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="ChipPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
            <TextBlock x:Name="SelectionSummary"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource InkSecondaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
