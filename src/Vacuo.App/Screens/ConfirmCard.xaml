<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vacuo.App.Screens.ConfirmCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Visibility="Collapsed">

    <!-- The confirm step: a card with the VOID black hole above what is about to go. -->
    <Grid Background="#D90A0811" KeyDown="OnKeyDown">
        <Border Width="540"
                MaxHeight="600"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="22"
                BorderThickness="1.5">
            <!-- The rim catches the black hole's light at the top and fades into the void below. -->
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#CC9D7CFF" Offset="0" />
                    <GradientStop Color="#409D7CFF" Offset="0.45" />
                    <GradientStop Color="#142C2441" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#FF1B1430" Offset="0" />
                    <GradientStop Color="#FF0E0B18" Offset="0.4" />
                    <GradientStop Color="#FF0A0811" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="150" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <canvas:CanvasAnimatedControl x:Name="Hole"
                                              ClearColor="#00000000"
                                              Paused="True"
                                              IsFixedTimeStep="False"
                                              Update="OnHoleUpdate"
                                              Draw="OnHoleDraw" />

                <ScrollViewer Grid.Row="1" Padding="24,4,24,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="TitleText"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock x:Name="SummaryText"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource InkSecondaryBrush}" />
                        <StackPanel x:Name="Items" Spacing="12" />
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Padding="24,16,24,20" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CancelButton"
                            Style="{StaticResource VoidGhostButtonStyle}"
                            Click="OnCancelClick" />
                    <Button x:Name="ConfirmButton"
                            Grid.Column="1"
                            Style="{StaticResource VoidPrimaryButtonStyle}"
                            Click="OnConfirmClick" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
