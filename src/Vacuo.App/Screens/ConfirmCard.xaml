<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vacuo.App.Screens.ConfirmCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Visibility="Collapsed">

    <!-- The confirm step: a card with the VOID black hole above what is about to go. -->
    <Grid Background="{ThemeResource ScrimBrush}" KeyDown="OnKeyDown">
        <Border Width="540"
                MaxHeight="600"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="22"
                BorderThickness="1.5"
                BorderBrush="{ThemeResource ConfirmRimBrush}"
                Background="{ThemeResource ConfirmCardBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="150" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <canvas:CanvasAnimatedControl x:Name="Hole"
                                              AutomationProperties.AccessibilityView="Raw"
                                              ClearColor="#00000000"
                                              Paused="True"
                                              IsFixedTimeStep="False"
                                              Update="OnHoleUpdate"
                                              Draw="OnHoleDraw" />

                <ScrollViewer Grid.Row="1" Padding="24,4,24,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="TitleText"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource InkBrush}" />
                        <TextBlock x:Name="SummaryText"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource InkSecondaryBrush}" />
                        <StackPanel x:Name="Items" Spacing="12" />
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Padding="24,16,24,20" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CancelButton"
                            Style="{StaticResource VoidGhostButtonStyle}"
                            Click="OnCancelClick" />
                    <Button x:Name="ConfirmButton"
                            Grid.Column="1"
                            Style="{StaticResource VoidPrimaryButtonStyle}"
                            Click="OnConfirmClick" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
