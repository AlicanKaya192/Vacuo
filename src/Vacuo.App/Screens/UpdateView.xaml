<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vacuo.App.Screens.UpdateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Click="OnBackClick" />
            <TextBlock x:Name="ScreenTitle"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8" Padding="0,0,12,12">
                <!-- The new version falling into the void as it downloads; numbers beside it. -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <canvas:CanvasAnimatedControl x:Name="HoleCanvas"
                                                      Height="170"
                                                      ClearColor="#00000000"
                                                      IsHitTestVisible="False"
                                                      Paused="True"
                                                      IsFixedTimeStep="False"
                                                      Update="OnHoleUpdate"
                                                      Draw="OnHoleDraw" />
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock x:Name="DetailText" Style="{StaticResource CardBodyStyle}" />
                            <!-- A plain bar as well: the only progress shown when animations are off (vacuo-kurallar 9). -->
                            <Grid x:Name="ProgressTrack"
                                  Height="6"
                                  CornerRadius="3"
                                  Background="{StaticResource LineBrush}"
                                  SizeChanged="OnTrackSizeChanged">
                                <Border x:Name="ProgressFill"
                                        Width="0"
                                        HorizontalAlignment="Left"
                                        CornerRadius="3"
                                        Background="{StaticResource AccentBrush}" />
                            </Grid>
                            <TextBlock x:Name="MessageText"
                                       Style="{StaticResource CardBodyStyle}"
                                       Foreground="{StaticResource WarningBrush}"
                                       Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="PrimaryButton" Style="{StaticResource VoidPrimaryButtonStyle}" Click="OnPrimaryClick" />
                                <Button x:Name="BackgroundButton" Click="OnBackgroundClick" />
                                <Button x:Name="CancelButton" Click="OnCancelClick" />
                                <Button x:Name="ReleasesButton" Click="OnReleasesClick" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="NotesCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="NotesTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="NotesText"
                                   Style="{StaticResource CardBodyStyle}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
