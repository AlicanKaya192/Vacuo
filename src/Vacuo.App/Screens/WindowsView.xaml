<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vacuo.App.Screens.WindowsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vacuo.App.Screens">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Click="OnBackClick" />
            <TextBlock x:Name="ScreenTitle"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}" />
            <Button x:Name="JournalButton" Grid.Column="2" Click="OnJournalClick" />
            <Button x:Name="RescanButton" Grid.Column="3" Click="OnRescanClick" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>

            <!-- The user's own temp folder: no administrator, everything goes to the Recycle Bin. -->
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TempHeader" VerticalAlignment="Center" Style="{StaticResource CardTitleStyle}" />
                    <CheckBox x:Name="SelectAllBox"
                              Grid.Column="1"
                              MinWidth="0"
                              Checked="OnSelectAllChecked"
                              Unchecked="OnSelectAllUnchecked" />
                </Grid>
                <TextBlock x:Name="TempHint" Grid.Row="1" Style="{StaticResource CardBodyStyle}" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TempList" Spacing="4" Padding="0,0,12,0" />
                </ScrollViewer>
                <StackPanel x:Name="TempResult" Grid.Row="3" Spacing="2" />
                <Grid Grid.Row="4"
                      ColumnSpacing="12"
                      BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="0,1,0,0"
                      Padding="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TempSummary"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource InkSecondaryBrush}" />
                    <Button x:Name="TempMoveButton"
                            Grid.Column="1"
                            IsEnabled="False"
                            Background="{StaticResource AccentBrush}"
                            Foreground="{StaticResource VoidBrush}"
                            FontWeight="SemiBold"
                            Click="OnTempMoveClick" />
                </Grid>
            </Grid>

            <!-- Administrator cleanups: deleted for good, each one chosen on its own. -->
            <Grid Grid.Column="1"
                  RowSpacing="6"
                  BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1,0,0,0"
                  Padding="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="AdminHeader" Style="{StaticResource CardTitleStyle}" />
                <TextBlock x:Name="AdminHint" Grid.Row="1" Style="{StaticResource CardBodyStyle}" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10" Padding="0,0,12,0">
                        <StackPanel x:Name="AdminList" Spacing="4" />
                        <StackPanel x:Name="WindowsOldPanel" Spacing="6" Visibility="Collapsed">
                            <TextBlock x:Name="WindowsOldText" Style="{StaticResource CardBodyStyle}" />
                            <Button x:Name="WindowsOldButton"
                                    HorizontalAlignment="Stretch"
                                    Click="OnOpenDiskCleanupClick" />
                        </StackPanel>
                        <StackPanel x:Name="AdminResult" Spacing="2" />
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="3"
                      RowSpacing="8"
                      BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="0,1,0,0"
                      Padding="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="AdminSummary"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource InkSecondaryBrush}" />
                    <Button x:Name="AdminRunButton"
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Background="{StaticResource WarningBrush}"
                            Foreground="{StaticResource VoidBrush}"
                            FontWeight="SemiBold"
                            Click="OnAdminRunClick" />
                </Grid>
            </Grid>
        </Grid>

        <local:ConfirmCard x:Name="Confirm" Grid.RowSpan="2" />
    </Grid>
</UserControl>
