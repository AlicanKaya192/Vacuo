<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vacuo.App.Screens.DiskTimelineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Click="OnBackClick" />
            <TextBlock x:Name="ScreenTitle"
                       AutomationProperties.HeadingLevel="Level1"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource InkBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8" Padding="0,0,12,12">
                <!-- The answer first; the steps behind it underneath, newest on top. -->
                <StackPanel Spacing="2">
                    <TextBlock x:Name="LargestText"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource InkBrush}"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="TotalText" Style="{StaticResource CardBodyStyle}" />
                </StackPanel>

                <StackPanel x:Name="StepCards" Spacing="8" />

                <!-- What the screen cannot know is said here, so a date or a folder is not read as a reason. -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="NoteTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="NoteText" Style="{StaticResource CardBodyStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
