<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vacuo.App.Screens.WeekView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Click="OnBackClick" />
            <TextBlock x:Name="ScreenTitle"
                       AutomationProperties.HeadingLevel="Level1"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource InkBrush}" />
        </Grid>

        <!-- The week in one or two sentences: what went to the Recycle Bin and what was freed at once. -->
        <StackPanel Grid.Row="1" Spacing="2">
            <TextBlock x:Name="TotalText" Style="{StaticResource CardBodyStyle}" Foreground="{ThemeResource InkBrush}" />
            <TextBlock x:Name="DeletedText" Style="{StaticResource CardBodyStyle}" Visibility="Collapsed" />
        </StackPanel>

        <!-- The carousel: one card in front, its neighbours turned away in perspective. -->
        <Grid x:Name="CarouselArea" Grid.Row="2" RowSpacing="12" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="Stage" Height="220">
                <Grid.Transform3D>
                    <PerspectiveTransform3D Depth="800" />
                </Grid.Transform3D>
            </Grid>
            <StackPanel x:Name="CarouselButtons"
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center">
                <Button x:Name="PreviousButton" Style="{StaticResource VoidIconButtonStyle}" Click="OnPreviousClick">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource VoidIconButtonStyle}" Click="OnNextClick">
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- With Windows animations off: the same cards as a plain list (vacuo-kurallar 9). -->
        <ScrollViewer x:Name="ListArea" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel x:Name="List" Spacing="8" Padding="0,0,12,12" />
        </ScrollViewer>
    </Grid>
</UserControl>
