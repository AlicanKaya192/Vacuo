<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vacuo.App.Screens.DiskView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:local="using:Vacuo.App.Screens">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Click="OnBackClick" />
            <Button x:Name="JournalButton" Grid.Column="2" Click="OnJournalClick" />
            <TextBlock x:Name="ScreenTitle"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}" />
            <Button x:Name="RescanButton" Grid.Column="3" Click="OnRescanClick" />
        </Grid>

        <StackPanel x:Name="ResultPanel"
                    Grid.Row="1"
                    Spacing="4"
                    Visibility="Collapsed">
            <TextBlock x:Name="MovedCounter"
                       HorizontalAlignment="Center"
                       FontSize="26"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{StaticResource AccentBrush}" />
            <TextBlock x:Name="MovedNote"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Style="{StaticResource CardBodyStyle}" />
            <StackPanel x:Name="FailureList" Spacing="2" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer x:Name="ListScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Padding="0,0,12,0">
                <!-- Where the used space goes (Aşama 3d A, dilim 2): categories flowing into the buckets. -->
                <StackPanel>
                    <TextBlock x:Name="CategoriesTitle" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock x:Name="CategoriesNote" Style="{StaticResource CardBodyStyle}" />
                    <canvas:CanvasAnimatedControl x:Name="FlowCanvas"
                                                  Height="184"
                                                  Margin="0,4,0,0"
                                                  ClearColor="#00000000"
                                                  IsHitTestVisible="False"
                                                  Paused="True"
                                                  IsFixedTimeStep="False"
                                                  Visibility="Collapsed"
                                                  Update="OnFlowUpdate"
                                                  Draw="OnFlowDraw" />
                </StackPanel>
                <StackPanel x:Name="BucketList" Spacing="14" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3"
              ColumnSpacing="12"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="0,1,0,0"
              Padding="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionSummary"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource InkSecondaryBrush}" />
            <Button x:Name="MoveButton"
                    Grid.Column="1"
                    IsEnabled="False"
                    Style="{StaticResource VoidPrimaryButtonStyle}"
                    Click="OnMoveClick" />
        </Grid>

        <local:ConfirmCard x:Name="Confirm" Grid.RowSpan="4" />

        <canvas:CanvasAnimatedControl x:Name="BurstCanvas"
                                      Grid.RowSpan="4"
                                      ClearColor="#00000000"
                                      IsHitTestVisible="False"
                                      Paused="True"
                                      IsFixedTimeStep="False"
                                      Visibility="Collapsed"
                                      Update="OnBurstUpdate"
                                      Draw="OnBurstDraw" />
    </Grid>
</UserControl>
