<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vacuo.App.Screens.DiskView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Click="OnBackClick" />
            <TextBlock x:Name="ScreenTitle"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}" />
            <Button x:Name="RescanButton" Grid.Column="2" Click="OnRescanClick" />
        </Grid>

        <StackPanel x:Name="ResultPanel"
                    Grid.Row="1"
                    Spacing="4"
                    Visibility="Collapsed">
            <TextBlock x:Name="MovedCounter"
                       HorizontalAlignment="Center"
                       FontSize="26"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{StaticResource AccentBrush}" />
            <TextBlock x:Name="MovedNote"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Style="{StaticResource CardBodyStyle}" />
            <StackPanel x:Name="FailureList" Spacing="2" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer x:Name="ListScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="BucketList" Spacing="14" Padding="0,0,12,0" />
        </ScrollViewer>

        <Grid Grid.Row="3"
              ColumnSpacing="12"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="0,1,0,0"
              Padding="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionSummary"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource InkSecondaryBrush}" />
            <Button x:Name="MoveButton"
                    Grid.Column="1"
                    IsEnabled="False"
                    Background="{StaticResource AccentBrush}"
                    Foreground="{StaticResource VoidBrush}"
                    FontWeight="SemiBold"
                    Click="OnMoveClick" />
        </Grid>

        <!-- The confirm step: a card with the VOID black hole above what is about to go. -->
        <Grid x:Name="ConfirmOverlay"
              Grid.RowSpan="4"
              Background="#D90A0811"
              Visibility="Collapsed"
              KeyDown="OnConfirmKeyDown">
            <Border Width="540"
                    MaxHeight="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="22"
                    BorderThickness="1.5">
                <!-- The rim catches the black hole's light at the top and fades into the void below. -->
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#CC9D7CFF" Offset="0" />
                        <GradientStop Color="#409D7CFF" Offset="0.45" />
                        <GradientStop Color="#142C2441" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#FF1B1430" Offset="0" />
                        <GradientStop Color="#FF0E0B18" Offset="0.4" />
                        <GradientStop Color="#FF0A0811" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <canvas:CanvasAnimatedControl x:Name="ConfirmHole"
                                                  ClearColor="#00000000"
                                                  Paused="True"
                                                  IsFixedTimeStep="False"
                                                  Update="OnConfirmHoleUpdate"
                                                  Draw="OnConfirmHoleDraw" />

                    <ScrollViewer Grid.Row="1" Padding="24,4,24,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="ConfirmTitle"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock x:Name="ConfirmSummary"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource InkSecondaryBrush}" />
                            <StackPanel x:Name="ConfirmContent" Spacing="12" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Padding="24,16,24,20" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ConfirmCancelButton"
                                Style="{StaticResource VoidGhostButtonStyle}"
                                Click="OnConfirmCancelClick" />
                        <Button x:Name="ConfirmMoveButton"
                                Grid.Column="1"
                                Style="{StaticResource VoidPrimaryButtonStyle}"
                                Click="OnConfirmMoveClick" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <canvas:CanvasAnimatedControl x:Name="BurstCanvas"
                                      Grid.RowSpan="4"
                                      ClearColor="#00000000"
                                      IsHitTestVisible="False"
                                      Paused="True"
                                      IsFixedTimeStep="False"
                                      Visibility="Collapsed"
                                      Update="OnBurstUpdate"
                                      Draw="OnBurstDraw" />
    </Grid>
</UserControl>
