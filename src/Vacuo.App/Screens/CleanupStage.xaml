<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vacuo.App.Screens.CleanupStage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Visibility="Collapsed">

    <!-- While a cleanup runs: the black hole eating its planets, how far it is, and how many items are done. -->
    <Grid Background="{ThemeResource ScrimBrush}">
        <Border Width="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="22"
                BorderThickness="1.5"
                BorderBrush="{ThemeResource ConfirmRimBrush}"
                Background="{ThemeResource ConfirmCardBrush}">
            <StackPanel Padding="0,0,0,22" Spacing="4">
                <canvas:CanvasAnimatedControl x:Name="Scene"
                                              Height="300"
                                              AutomationProperties.AccessibilityView="Raw"
                                              ClearColor="#00000000"
                                              Paused="True"
                                              IsFixedTimeStep="False"
                                              Update="OnSceneUpdate"
                                              Draw="OnSceneDraw" />
                <TextBlock x:Name="TitleText"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           Foreground="{ThemeResource InkSecondaryBrush}" />
                <TextBlock x:Name="PercentText"
                           HorizontalAlignment="Center"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource InkBrush}" />
                <TextBlock x:Name="CountText"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource InkSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
