<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Vacuo.App.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:screens="using:Vacuo.App.Screens"
    Title="Vacuo">

    <Grid x:Name="Root"
          Background="{ThemeResource VoidBrush}"
          Padding="14"
          RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="VoidRow" Height="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Vacuo's own header in place of a Windows title bar. The window never moves: it stays above the
             tray (Alican, 20 October 2026: it had been dragged away by accident). -->
        <Grid x:Name="Header" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- The logo, the same black hole as the app icon (tools\make-app-icon.ps1; Alican, 27 October
                     2026: "önceden daha gerçekçi karadelik yapmıştık yine öyle yap"). Its glow breathes on the
                     compositor, so it costs the UI thread nothing; it stops while the panel is hidden and stays
                     still when Windows animations are off (vacuo-kurallar 9). A contrast theme shows the plain
                     ring in the theme's colours instead of the picture (Aşama 3f). -->
                <Grid Width="22" Height="22" VerticalAlignment="Center">
                    <Grid.Resources>
                        <Storyboard x:Name="LogoGlowMotion" RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="LogoGlow"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.45"
                                             To="0.9"
                                             Duration="0:0:2.4" />
                        </Storyboard>
                    </Grid.Resources>
                    <Ellipse x:Name="LogoGlow" Opacity="0.7" Fill="{ThemeResource LogoGlowBrush}" />
                    <!-- The name beside it says the same, so a screen reader skips the picture. -->
                    <Image x:Name="LogoImage" Width="22" Height="22" AutomationProperties.AccessibilityView="Raw" />
                    <Grid x:Name="LogoContrastRing" Visibility="Collapsed">
                        <Ellipse Width="17" Height="17" StrokeThickness="2.5" Stroke="{ThemeResource LogoRingBrush}" />
                        <Ellipse Width="11" Height="11" Fill="{ThemeResource VoidBrush}" />
                    </Grid>
                </Grid>
                <TextBlock Text="VACUO"
                           CharacterSpacing="300"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource InkBrush}" />
                <TextBlock x:Name="Tagline"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource InkSecondaryBrush}" />
                <!-- A new version, its download, or the version just installed; low enough to keep the header's height. -->
                <Button x:Name="UpdateBadge"
                        Style="{StaticResource VoidPrimaryButtonStyle}"
                        Padding="10,2"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="OnUpdateBadgeClick" />
            </StackPanel>
            <!-- Settings opens from the cards only, like every other screen. "Freed this week" has its card on the
                 Geçmiş tab (Alican, 5 November 2026: every feature in its own place). -->
            <Button x:Name="SettingsButton"
                    Grid.Column="2"
                    Style="{StaticResource VoidIconButtonStyle}"
                    Click="OnSettingsClick">
                <FontIcon Glyph="&#xE713;" FontSize="13" />
            </Button>
            <Button x:Name="HideButton"
                    Grid.Column="3"
                    Style="{StaticResource VoidIconButtonStyle}"
                    Click="OnHideClick">
                <FontIcon Glyph="&#xE921;" FontSize="12" />
            </Button>
        </Grid>

        <!-- ClearColor takes no ThemeResource; the code sets it from Root's theme background (Aşama 3f). -->
        <canvas:CanvasAnimatedControl x:Name="VoidCanvas"
                                      AutomationProperties.AccessibilityView="Raw"
                                      Grid.Row="1"
                                      ClearColor="#FF0A0811"
                                      Paused="True"
                                      IsFixedTimeStep="False"
                                      Update="OnVoidUpdate"
                                      Draw="OnVoidDraw" />
        <!-- Right under the sun SunHeat draws: 200 wide and right-aligned, so its middle is SunHeat.RightInset in;
             the top margin clears the sun's core (SunHeat.SunCenter). Only the faint outer glow reaches the text. -->
        <!-- Part of the void scene: it leaves and comes back with VoidCanvas, never shows over a screen. -->
        <StackPanel x:Name="GpuTemperaturePanel"
                    Grid.Row="1"
                    Width="200"
                    Margin="0,104,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
            <TextBlock x:Name="GpuTemperatureValue"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TemperatureBrush}"
                       TextAlignment="Center" />
            <TextBlock x:Name="GpuTemperatureLabel"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{StaticResource CardBodyStyle}" />
        </StackPanel>

        <!-- The four tabs (Alican, 5 November 2026: "her birinin ayrı yeri olsun"); PanelMenu says what is on each.
             Left and right arrows move between them. -->
        <StackPanel x:Name="TabsBar"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    KeyDown="OnTabsKeyDown">
            <Button x:Name="DiskTabButton" Style="{StaticResource VoidTabStyle}" Click="OnTabClick" />
            <Button x:Name="ProgramsTabButton" Style="{StaticResource VoidTabStyle}" Click="OnTabClick" />
            <Button x:Name="OrganizeTabButton" Style="{StaticResource VoidTabStyle}" Click="OnTabClick" />
            <Button x:Name="HistoryTabButton" Style="{StaticResource VoidTabStyle}" Click="OnTabClick" />
        </StackPanel>

        <!-- Only scrolls on a screen too short for the measured panel; normally every card shows. -->
        <ScrollViewer x:Name="CardsScroller"
                      Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      SizeChanged="OnCardsSizeChanged">
        <!-- One tab's cards show at a time, all in the same cell: the panel is measured with every tab in it, so
             it is as tall as the tallest and keeps its size when the tab changes (vacuo-kurallar 13, 14). -->
        <Grid x:Name="Cards" VerticalAlignment="Top" SizeChanged="OnCardsSizeChanged">
            <Grid.Transform3D>
                <PerspectiveTransform3D Depth="700" />
            </Grid.Transform3D>

            <Grid x:Name="DiskTabCards" ColumnSpacing="8" RowSpacing="8" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="DiskCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="DiskTitle" Style="{StaticResource CardTitleStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="112" Height="112">
                                <canvas:CanvasControl x:Name="DiskRingCanvas"
                                                      AutomationProperties.AccessibilityView="Raw"
                                                      ClearColor="#00000000"
                                                      Draw="OnDiskRingDraw" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="DiskFreeText"
                                               HorizontalAlignment="Center"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource InkBrush}" />
                                    <TextBlock x:Name="DiskFreeLabel"
                                               HorizontalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{ThemeResource InkSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="DiskLegend"
                                        Grid.Column="1"
                                        Spacing="4"
                                        VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="DiskBody" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="DiskInspectButton"
                                HorizontalAlignment="Stretch"
                                Click="OnDiskInspectClick" />
                    </StackPanel>
                </Border>
                <!-- As tall as the Disk card beside it: the three kinds sit centred between title and button. -->
                <Border x:Name="WindowsCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="WindowsTitle" Style="{StaticResource CardTitleStyle}" />
                        <StackPanel Grid.Row="1" Spacing="8" Margin="0,10,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock x:Name="WindowsItemTemp" Style="{StaticResource CardBodyStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE895;" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock x:Name="WindowsItemUpdates" Style="{StaticResource CardBodyStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7B8;" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock x:Name="WindowsItemComponents" Style="{StaticResource CardBodyStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="WindowsInspectButton"
                                Grid.Row="2"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                Click="OnWindowsInspectClick" />
                    </Grid>
                </Border>
                <Border x:Name="DiskMapCard" Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="DiskMapCardTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="DiskMapCardBody" Grid.Row="1" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="DiskMapButton" Grid.Row="2" HorizontalAlignment="Stretch" Click="OnDiskMapClick" />
                    </Grid>
                </Border>
                <Border x:Name="DiskGrowthCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="DiskGrowthCardTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="DiskGrowthCardBody" Grid.Row="1" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="DiskGrowthButton" Grid.Row="2" HorizontalAlignment="Stretch" Click="OnDiskGrowthClick" />
                    </Grid>
                </Border>
                <Border x:Name="BrowsersCard" Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="BrowsersCardTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="BrowsersCardBody" Grid.Row="1" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="BrowsersButton" Grid.Row="2" HorizontalAlignment="Stretch" Click="OnBrowsersClick" />
                    </Grid>
                </Border>
                <Border x:Name="DuplicatesCard" Grid.Row="2" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="DuplicatesCardTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="DuplicatesCardBody" Grid.Row="1" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="DuplicatesButton" Grid.Row="2" HorizontalAlignment="Stretch" Click="OnDuplicatesClick" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="ProgramsTabCards" ColumnSpacing="8" RowSpacing="8" VerticalAlignment="Top" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="UninstallCard" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="UninstallCardTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="UninstallCardBody" Grid.Row="1" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="UninstallButton" Grid.Row="2" HorizontalAlignment="Stretch" Click="OnUninstallClick" />
                    </Grid>
                </Border>
                <Border x:Name="DriversCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="DriversCardTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="DriversCardBody" Grid.Row="1" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="DriversButton" Grid.Row="2" HorizontalAlignment="Stretch" Click="OnDriversClick" />
                    </Grid>
                </Border>
                <!-- Full width without a battery (PlaceMemoryCard), so no card stands alone beside a gap. -->
                <Border x:Name="MemoryCard" Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="MemoryTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="MemoryPressureText" Grid.Row="1" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="MemoryBody" Grid.Row="2" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="MemoryInspectButton"
                                Grid.Row="3"
                                HorizontalAlignment="Stretch"
                                Click="OnMemoryInspectClick" />
                    </Grid>
                </Border>
                <!-- Only on a machine with a battery (Aşama 3b); shown once the driver has answered. -->
                <Border x:Name="BatteryCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="BatteryTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="BatteryHealthText" Grid.Row="1" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="BatteryBody" Grid.Row="2" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="BatteryInspectButton"
                                Grid.Row="3"
                                HorizontalAlignment="Stretch"
                                Click="OnBatteryInspectClick" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="OrganizeTabCards" ColumnSpacing="8" VerticalAlignment="Top" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="OrganizeCard" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="OrganizeTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="OrganizeBody" Grid.Row="1" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="OrganizeInspectButton"
                                Grid.Row="2"
                                HorizontalAlignment="Stretch"
                                Click="OnOrganizeInspectClick" />
                    </Grid>
                </Border>
                <Border x:Name="RemindersCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="RemindersCardTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="RemindersCardBody" Grid.Row="1" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="RemindersButton" Grid.Row="2" HorizontalAlignment="Stretch" Click="OnOrganizeInspectClick" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="HistoryTabCards" ColumnSpacing="8" VerticalAlignment="Top" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="JournalCard" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="JournalCardTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="JournalCardBody" Grid.Row="1" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="JournalButton" Grid.Row="2" HorizontalAlignment="Stretch" Click="OnJournalClick" />
                    </Grid>
                </Border>
                <Border x:Name="WeekCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="WeekCardTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="WeekCardBody" Grid.Row="1" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="WeekButton" Grid.Row="2" HorizontalAlignment="Stretch" Click="OnWeekClick" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </ScrollViewer>

        <!-- The running version, always in sight (Alican, 20 October 2026); beside Quit, so the row keeps its height. -->
        <TextBlock x:Name="VersionText"
                   Grid.Row="4"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{ThemeResource InkSecondaryBrush}" />

        <Button x:Name="QuitButton"
                Grid.Row="4"
                HorizontalAlignment="Right"
                Click="OnQuitClick" />
    </Grid>
</Window>
