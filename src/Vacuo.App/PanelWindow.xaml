<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Vacuo.App.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:screens="using:Vacuo.App.Screens"
    Title="Vacuo">

    <Grid x:Name="Root"
          Background="{ThemeResource VoidBrush}"
          Padding="14"
          RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="VoidRow" Height="200" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Vacuo's own header in place of a Windows title bar. The window never moves: it stays above the
             tray (Alican, 20 October 2026: it had been dragged away by accident). -->
        <Grid x:Name="Header" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- The logo, the same black hole as the app icon (tools\make-app-icon.ps1; Alican, 27 October
                     2026: "önceden daha gerçekçi karadelik yapmıştık yine öyle yap"). Its glow breathes on the
                     compositor, so it costs the UI thread nothing; it stops while the panel is hidden and stays
                     still when Windows animations are off (vacuo-kurallar 9). A contrast theme shows the plain
                     ring in the theme's colours instead of the picture (Aşama 3f). -->
                <Grid Width="22" Height="22" VerticalAlignment="Center">
                    <Grid.Resources>
                        <Storyboard x:Name="LogoGlowMotion" RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="LogoGlow"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.45"
                                             To="0.9"
                                             Duration="0:0:2.4" />
                        </Storyboard>
                    </Grid.Resources>
                    <Ellipse x:Name="LogoGlow" Opacity="0.7" Fill="{ThemeResource LogoGlowBrush}" />
                    <!-- The name beside it says the same, so a screen reader skips the picture. -->
                    <Image x:Name="LogoImage" Width="22" Height="22" AutomationProperties.AccessibilityView="Raw" />
                    <Grid x:Name="LogoContrastRing" Visibility="Collapsed">
                        <Ellipse Width="17" Height="17" StrokeThickness="2.5" Stroke="{ThemeResource LogoRingBrush}" />
                        <Ellipse Width="11" Height="11" Fill="{ThemeResource VoidBrush}" />
                    </Grid>
                </Grid>
                <TextBlock Text="VACUO"
                           CharacterSpacing="300"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource InkBrush}" />
                <TextBlock x:Name="Tagline"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource InkSecondaryBrush}" />
                <!-- A new version, its download, or the version just installed; low enough to keep the header's height. -->
                <Button x:Name="UpdateBadge"
                        Style="{StaticResource VoidPrimaryButtonStyle}"
                        Padding="10,2"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="OnUpdateBadgeClick" />
            </StackPanel>
            <!-- "Freed this week" and Settings open from the cards only, like every other screen (Alican, 21 October 2026:
                 its own icon button beside Settings). -->
            <Button x:Name="WeekButton"
                    Grid.Column="1"
                    Style="{StaticResource VoidIconButtonStyle}"
                    Click="OnWeekClick">
                <FontIcon Glyph="&#xE81C;" FontSize="13" />
            </Button>
            <Button x:Name="SettingsButton"
                    Grid.Column="2"
                    Style="{StaticResource VoidIconButtonStyle}"
                    Click="OnSettingsClick">
                <FontIcon Glyph="&#xE713;" FontSize="13" />
            </Button>
            <Button x:Name="HideButton"
                    Grid.Column="3"
                    Style="{StaticResource VoidIconButtonStyle}"
                    Click="OnHideClick">
                <FontIcon Glyph="&#xE921;" FontSize="12" />
            </Button>
        </Grid>

        <!-- ClearColor takes no ThemeResource; the code sets it from Root's theme background (Aşama 3f). -->
        <canvas:CanvasAnimatedControl x:Name="VoidCanvas"
                                      AutomationProperties.AccessibilityView="Raw"
                                      Grid.Row="1"
                                      ClearColor="#FF0A0811"
                                      Paused="True"
                                      IsFixedTimeStep="False"
                                      Update="OnVoidUpdate"
                                      Draw="OnVoidDraw" />
        <!-- Right under the sun SunHeat draws: 200 wide and right-aligned, so its middle is SunHeat.RightInset in;
             the top margin clears the sun's core (SunHeat.SunCenter). Only the faint outer glow reaches the text. -->
        <!-- Part of the void scene: it leaves and comes back with VoidCanvas, never shows over a screen. -->
        <StackPanel x:Name="GpuTemperaturePanel"
                    Grid.Row="1"
                    Width="200"
                    Margin="0,104,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
            <TextBlock x:Name="GpuTemperatureValue"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TemperatureBrush}"
                       TextAlignment="Center" />
            <TextBlock x:Name="GpuTemperatureLabel"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{StaticResource CardBodyStyle}" />
        </StackPanel>

        <!-- Only scrolls on a screen too short for the measured panel; normally every card shows. -->
        <ScrollViewer x:Name="CardsScroller"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      SizeChanged="OnCardsSizeChanged">
        <!-- Two columns (B-137): Disk and Windows on the left, Memory, Organize and Battery on the right;
             the tools card spans both below them. -->
        <Grid x:Name="Cards" ColumnSpacing="8" RowSpacing="8" SizeChanged="OnCardsSizeChanged">
            <Grid.Transform3D>
                <PerspectiveTransform3D Depth="700" />
            </Grid.Transform3D>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Both columns end level: the stretching row takes up the shorter column's spare height. -->
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="DiskCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="DiskTitle" Style="{StaticResource CardTitleStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="112" Height="112">
                                <canvas:CanvasControl x:Name="DiskRingCanvas"
                                                      AutomationProperties.AccessibilityView="Raw"
                                                      ClearColor="#00000000"
                                                      Draw="OnDiskRingDraw" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="DiskFreeText"
                                               HorizontalAlignment="Center"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource InkBrush}" />
                                    <TextBlock x:Name="DiskFreeLabel"
                                               HorizontalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{ThemeResource InkSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="DiskLegend"
                                        Grid.Column="1"
                                        Spacing="4"
                                        VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="DiskBody" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="DiskInspectButton"
                                HorizontalAlignment="Stretch"
                                Click="OnDiskInspectClick" />
                    </StackPanel>
                </Border>
                <!-- When it stretches, the three kinds sit centred between title and button, and the
                     button stays at the bottom like the cards beside it. -->
                <Border x:Name="WindowsCard" Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="WindowsTitle" Style="{StaticResource CardTitleStyle}" />
                        <StackPanel Grid.Row="1" Spacing="8" Margin="0,10,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock x:Name="WindowsItemTemp" Style="{StaticResource CardBodyStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE895;" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock x:Name="WindowsItemUpdates" Style="{StaticResource CardBodyStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7B8;" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock x:Name="WindowsItemComponents" Style="{StaticResource CardBodyStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="WindowsInspectButton"
                                Grid.Row="2"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                Click="OnWindowsInspectClick" />
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="RightColumn" Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="MemoryCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="MemoryTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="MemoryPressureText" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="MemoryBody" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="MemoryInspectButton"
                                HorizontalAlignment="Stretch"
                                Click="OnMemoryInspectClick" />
                    </StackPanel>
                </Border>
                <!-- Stretches instead when there is no battery and the left column is the taller one. -->
                <Border x:Name="OrganizeCard" Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="OrganizeTitle" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:Name="OrganizeBody" Style="{StaticResource CardBodyStyle}" />
                        </StackPanel>
                        <Button x:Name="OrganizeInspectButton"
                                Grid.Row="2"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                Click="OnOrganizeInspectClick" />
                    </Grid>
                </Border>
                <!-- Only on a machine with a battery (Aşama 3b); shown once the driver has answered.
                     On the right, the shorter column, so the panel does not grow (vacuo-kurallar 13). -->
                <Border x:Name="BatteryCard" Grid.Row="2" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="BatteryTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="BatteryHealthText" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="BatteryBody" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="BatteryInspectButton"
                                HorizontalAlignment="Stretch"
                                Click="OnBatteryInspectClick" />
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Tools without a card of their own (Aşama 3d): duplicate files, Kaldır and drivers. Full width and low,
                 buttons side by side, so neither column grows and no card stretches into a gap (vacuo-kurallar 13).
                 Without a battery (a desktop) it moves into the battery's place in the right column instead,
                 buttons below the text (PlaceToolsCard). -->
            <Border x:Name="ToolsCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                <Grid x:Name="ToolsLayout" ColumnSpacing="16" RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="ToolsTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="ToolsBody" Style="{StaticResource CardBodyStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="ToolsButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="DuplicatesButton" Click="OnDuplicatesClick" />
                        <Button x:Name="UninstallButton" Click="OnUninstallClick" />
                        <Button x:Name="DriversButton" Click="OnDriversClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- The running version, always in sight (Alican, 20 October 2026); beside Quit, so the row keeps its height. -->
        <TextBlock x:Name="VersionText"
                   Grid.Row="3"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{ThemeResource InkSecondaryBrush}" />

        <Button x:Name="QuitButton"
                Grid.Row="3"
                HorizontalAlignment="Right"
                Click="OnQuitClick" />
    </Grid>
</Window>
