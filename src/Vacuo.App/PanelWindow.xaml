<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Vacuo.App.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:screens="using:Vacuo.App.Screens"
    Title="Vacuo">

    <Grid x:Name="Root"
          Background="{StaticResource VoidBrush}"
          Padding="14"
          RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="VACUO"
                           CharacterSpacing="300"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock x:Name="Tagline"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource InkSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="HideButton"
                    Grid.Column="1"
                    Padding="10,6"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource InkSecondaryBrush}"
                    Click="OnHideClick">
                <FontIcon Glyph="&#xE921;" FontSize="12" />
            </Button>
        </Grid>

        <canvas:CanvasAnimatedControl x:Name="VoidCanvas"
                                      Grid.Row="1"
                                      ClearColor="#FF0A0811"
                                      Paused="True"
                                      IsFixedTimeStep="False"
                                      Update="OnVoidUpdate"
                                      Draw="OnVoidDraw" />

        <!-- Only scrolls on a screen too short for the measured panel; normally every card shows. -->
        <ScrollViewer x:Name="CardsScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Cards" Spacing="8">
            <StackPanel.Transform3D>
                <PerspectiveTransform3D Depth="700" />
            </StackPanel.Transform3D>
            <Border x:Name="DiskCard" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="DiskTitle" Style="{StaticResource CardTitleStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="112" Height="112">
                            <canvas:CanvasControl x:Name="DiskRingCanvas"
                                                  ClearColor="#00000000"
                                                  Draw="OnDiskRingDraw" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="DiskFreeText"
                                           HorizontalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}" />
                                <TextBlock x:Name="DiskFreeLabel"
                                           HorizontalAlignment="Center"
                                           FontSize="10"
                                           Foreground="{StaticResource InkSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="DiskLegend"
                                    Grid.Column="1"
                                    Spacing="4"
                                    VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="DiskBody" Style="{StaticResource CardBodyStyle}" />
                    <Button x:Name="DiskInspectButton"
                            HorizontalAlignment="Stretch"
                            Click="OnDiskInspectClick" />
                </StackPanel>
            </Border>
            <Border x:Name="WindowsCard" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="WindowsTitle" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock x:Name="WindowsBody" Style="{StaticResource CardBodyStyle}" />
                    <Button x:Name="WindowsInspectButton"
                            HorizontalAlignment="Stretch"
                            Click="OnWindowsInspectClick" />
                </StackPanel>
            </Border>
            <!-- The two cards still to come share a row, so the panel stays short enough for a laptop screen. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="MemoryCard" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="MemoryTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="MemoryBody" Style="{StaticResource CardBodyStyle}" />
                    </StackPanel>
                </Border>
                <Border x:Name="OrganizeCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="OrganizeTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="OrganizeBody" Style="{StaticResource CardBodyStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
        </ScrollViewer>

        <screens:DiskView x:Name="DiskScreenView"
                          Grid.Row="1"
                          Grid.RowSpan="2"
                          Visibility="Collapsed" />

        <screens:WindowsView x:Name="WindowsScreenView"
                             Grid.Row="1"
                             Grid.RowSpan="2"
                             Visibility="Collapsed" />

        <screens:JournalView x:Name="JournalScreenView"
                             Grid.Row="1"
                             Grid.RowSpan="2"
                             Visibility="Collapsed" />

        <Button x:Name="QuitButton"
                Grid.Row="3"
                HorizontalAlignment="Right"
                Click="OnQuitClick" />
    </Grid>
</Window>
