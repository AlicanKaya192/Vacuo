<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Vacuo.App.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:screens="using:Vacuo.App.Screens"
    Title="Vacuo">

    <Grid x:Name="Root"
          Background="{StaticResource VoidBrush}"
          Padding="14"
          RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="VoidRow" Height="200" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Vacuo's own header in place of a Windows title bar; on a screen it also moves the window. -->
        <Grid x:Name="Header" Background="Transparent" PointerPressed="OnHeaderPointerPressed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="VACUO"
                           CharacterSpacing="300"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock x:Name="Tagline"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource InkSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="HideButton"
                    Grid.Column="1"
                    Style="{StaticResource VoidIconButtonStyle}"
                    Click="OnHideClick">
                <FontIcon Glyph="&#xE921;" FontSize="12" />
            </Button>
        </Grid>

        <canvas:CanvasAnimatedControl x:Name="VoidCanvas"
                                      Grid.Row="1"
                                      ClearColor="#FF0A0811"
                                      Paused="True"
                                      IsFixedTimeStep="False"
                                      Update="OnVoidUpdate"
                                      Draw="OnVoidDraw" />

        <!-- Only scrolls on a screen too short for the measured panel; normally every card shows. -->
        <ScrollViewer x:Name="CardsScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <!-- Two columns (B-137): Disk and Windows on the left, Memory and Organize on the right. -->
        <Grid x:Name="Cards" ColumnSpacing="8">
            <Grid.Transform3D>
                <PerspectiveTransform3D Depth="700" />
            </Grid.Transform3D>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <Border x:Name="DiskCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="DiskTitle" Style="{StaticResource CardTitleStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="112" Height="112">
                                <canvas:CanvasControl x:Name="DiskRingCanvas"
                                                      ClearColor="#00000000"
                                                      Draw="OnDiskRingDraw" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="DiskFreeText"
                                               HorizontalAlignment="Center"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock x:Name="DiskFreeLabel"
                                               HorizontalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{StaticResource InkSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="DiskLegend"
                                        Grid.Column="1"
                                        Spacing="4"
                                        VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="DiskBody" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="DiskInspectButton"
                                HorizontalAlignment="Stretch"
                                Click="OnDiskInspectClick" />
                    </StackPanel>
                </Border>
                <Border x:Name="WindowsCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="WindowsTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="WindowsBody" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="WindowsInspectButton"
                                HorizontalAlignment="Stretch"
                                Click="OnWindowsInspectClick" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
                <Border x:Name="MemoryCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="MemoryTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="MemoryPressureText" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="MemoryBody" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="MemoryInspectButton"
                                HorizontalAlignment="Stretch"
                                Click="OnMemoryInspectClick" />
                    </StackPanel>
                </Border>
                <Border x:Name="OrganizeCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="OrganizeTitle" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="OrganizeBody" Style="{StaticResource CardBodyStyle}" />
                        <Button x:Name="OrganizeInspectButton"
                                HorizontalAlignment="Stretch"
                                Click="OnOrganizeInspectClick" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <Button x:Name="QuitButton"
                Grid.Row="3"
                HorizontalAlignment="Right"
                Click="OnQuitClick" />
    </Grid>
</Window>
