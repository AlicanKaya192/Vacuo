<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No window and no console: it runs while the user is away. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Vacuo.Maintenance</AssemblyName>
    <ApplicationIcon>..\Vacuo.App\Assets\vacuo.ico</ApplicationIcon>
    <RootNamespace>Vacuo.Maintenance</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Desktop sorting here gives its folders the same icons as the panel does. -->
    <Content Include="..\Vacuo.App\Assets\FolderIcons\*.ico" Link="Assets\FolderIcons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vacuo.Core\Vacuo.Core.csproj" />
    <ProjectReference Include="..\Vacuo.Windows\Vacuo.Windows.csproj" />
  </ItemGroup>

</Project>
